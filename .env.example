# ── Polymarket CLOB credentials ────────────────────────────────────────────────
# Generate via https://polymarket.com → Settings → API Keys
POLYMARKET_API_KEY=your_api_key_here
POLYMARKET_API_SECRET=your_api_secret_here
POLYMARKET_API_PASSPHRASE=your_api_passphrase_here

# Polygon (MATIC) private key for order signing (EIP-712)
# This wallet MUST hold USDC on Polygon and have approved the CLOB contract.
# NEVER commit this file with a real key.
PRIVATE_KEY=0xyour_polygon_private_key_here

# ── Target market (optional — auto-discovered if blank) ────────────────────────
# Token IDs for the specific Polymarket contract you want to trade.
# Example: "Will BTC exceed $100,000 by [date]?"
# Find token IDs at: https://clob.polymarket.com/markets?tag=Bitcoin
YES_TOKEN_ID=
NO_TOKEN_ID=
BTC_CONDITION_ID=

# ── Capital ────────────────────────────────────────────────────────────────────
# Starting capital in USDC.  If your wallet balance is >0 it will be used
# instead (fetched automatically at startup).
INITIAL_CAPITAL=1000

# ── Logging ────────────────────────────────────────────────────────────────────
# DEBUG for verbose order/detection output, INFO for normal operation
LOG_LEVEL=INFO
